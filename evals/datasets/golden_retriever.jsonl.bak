    "expected_chunk_ids": [
      "75854f3fe7b604a25d53c51b7fe0fd2b"
    ],
    "library": "langgraph",
    "type": "simple"
  },
  {
    "id": "q005",
    "input": "I need to quickly prototype a straightforward sequence of tasks without overhauling my existing code. Which LangGraph interface should I pick?",
    "expected_output": "The Functional API is best for quick prototyping of simple, sequential workflows with minimal changes to your existing code.",
    "source_docs": [
      "langgraph/choosing-apis.mdx"
    ],
    "expected_chunk_ids": [
      "019b6723033b48124b8cd8e9b452ff4a"
    ],
    "library": "langgraph",
    "type": "simple"
  },
  {
    "id": "q006",
    "input": "When creating a transfer tool without specifying a description, what description will it use?",
    "expected_output": "It defaults to \"Transfer to {agent_name}\", substituting the provided agent name into the template.",
    "source_docs": [
      "how-tos/multi_agent.md"
    ],
    "expected_chunk_ids": [
      "cdebc68ec25e2d2bc38ccaeb4256b874"
    ],
    "library": "langgraph",
    "type": "simple"
  },
  {
    "id": "q007",
    "input": "How does the summarize_conversation function prune older messages after updating the summary?",
    "expected_output": "It creates RemoveMessage commands for all but the two most recent messages in state[\"messages\"], removing older entries from the history.",
    "source_docs": [
      "how-tos/memory/add-memory.md"
    ],
    "expected_chunk_ids": [
      "ecd1cf106395dfa85f8fdf6622bba03d"
    ],
    "library": "langgraph",
    "type": "simple"
  },
  {
    "id": "q008",
    "input": "How does the call_model function retrieve the instructions before formatting its prompt?",
    "expected_output": "It fetches the entry from the store under the namespace ('agent_instructions',) with key 'agent_a' and extracts its instructions field.",
    "source_docs": [
      "concepts/memory.md"
    ],
    "expected_chunk_ids": [
      "de7719b58d97496244322c4c04ab1d8c"
    ],
    "library": "langgraph",
    "type": "simple"
  },
  {
    "id": "q009",
    "input": "What can trigger a maximum steps reached error when compiling a LangGraph StateGraph?",
    "expected_output": "It means the graph exceeded the default step limit—often because cyclical edges create an infinite loop, although complex graphs can also hit the limit.",
    "source_docs": [
      "langgraph/errors/GRAPH_RECURSION_LIMIT.mdx"
    ],
    "expected_chunk_ids": [
      "13c6201cc702f6a30df1d9fcb0ccb351"
    ],
    "library": "langgraph",
    "type": "simple"
  },
  {
    "id": "q010",
    "input": "How can I include environment variables from a local .env file in my configuration?",
    "expected_output": "Specify the path to the .env file in the \"env\" field, for example \"./.env\".",
    "source_docs": [
      "concepts/application_structure.md"
    ],
    "expected_chunk_ids": [
      "dbbcd10a51ab567b080a0115e05453dd"
