    ],
    "expected_chunk_ids": [
      "82fb3b36431aae49c2b7677700d07439"
    ],
    "library": "langchain",
    "type": "simple"
  },
  {
    "id": "q004",
    "input": "What function should I import to enable streaming updates from within a tool implementation?",
